<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.sergey-tihon.synapsed</string>
  <key>ProgramArguments</key><array><string>SYNAPSED_EXECUTABLE</string><string>--config</string><string>SYNAPSED_CONFIG</string></array>
  <key>EnvironmentVariables</key><dict>
    <key>XDG_CONFIG_HOME</key><string>SYNAPSED_CONFIG_HOME</string>
    <key>XDG_DATA_HOME</key><string>SYNAPSED_DATA_HOME</string>
    <key>XDG_STATE_HOME</key><string>SYNAPSED_STATE_HOME</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>SYNAPSED_STDOUT</string>
  <key>StandardErrorPath</key><string>SYNAPSED_STDERR</string>
</dict></plist>
