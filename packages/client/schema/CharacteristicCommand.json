{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "CharacteristicValue": {
      "anyOf": [
        {
          "description": "Boolean characteristic value.",
          "type": "boolean"
        },
        {
          "description": "Finite numeric characteristic value.",
          "type": "number"
        },
        {
          "description": "Bounded text characteristic value.",
          "maxLength": 1024,
          "type": "string"
        }
      ],
      "description": "JSON-compatible value of a characteristic observation or command."
    }
  },
  "description": "Write operation requested for a characteristic.",
  "oneOf": [
    {
      "additionalProperties": false,
      "description": "Set a characteristic to the supplied value.",
      "properties": {
        "op": {
          "const": "set",
          "type": "string"
        },
        "value": {
          "allOf": [
            {
              "$ref": "#/definitions/CharacteristicValue"
            }
          ],
          "description": "Target value for the set operation."
        }
      },
      "required": [
        "op",
        "value"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Move a numeric or enum characteristic by a relative number of steps.",
      "properties": {
        "op": {
          "const": "step",
          "type": "string"
        },
        "steps": {
          "description": "Signed number of steps, constrained to the inclusive range -100 through 100.",
          "maximum": 100,
          "minimum": -100,
          "type": "integer"
        }
      },
      "required": [
        "op",
        "steps"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Invert the current value of a boolean characteristic.",
      "properties": {
        "op": {
          "const": "toggle",
          "type": "string"
        }
      },
      "required": [
        "op"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Invoke a write-only action characteristic.",
      "properties": {
        "op": {
          "const": "invoke",
          "type": "string"
        }
      },
      "required": [
        "op"
      ],
      "type": "object"
    }
  ],
  "title": "CharacteristicCommand"
}
