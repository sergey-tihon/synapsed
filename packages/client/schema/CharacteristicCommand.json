{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "CharacteristicValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "maxLength": 1024,
          "type": "string"
        }
      ]
    }
  },
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "set",
          "type": "string"
        },
        "value": {
          "$ref": "#/definitions/CharacteristicValue"
        }
      },
      "required": [
        "op",
        "value"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "step",
          "type": "string"
        },
        "steps": {
          "maximum": 100,
          "minimum": -100,
          "type": "integer"
        }
      },
      "required": [
        "op",
        "steps"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "toggle",
          "type": "string"
        }
      },
      "required": [
        "op"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "invoke",
          "type": "string"
        }
      },
      "required": [
        "op"
      ],
      "type": "object"
    }
  ],
  "title": "CharacteristicCommand"
}
