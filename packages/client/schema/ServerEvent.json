{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ApiError": {
      "properties": {
        "code": {
          "$ref": "#/definitions/ErrorCode"
        },
        "message": {
          "maxLength": 256,
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "Characteristic": {
      "properties": {
        "access": {
          "$ref": "#/definitions/CharacteristicAccess"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/definitions/ApiError"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
          "type": "string"
        },
        "label": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "spec": {
          "$ref": "#/definitions/CharacteristicSpec"
        },
        "status": {
          "$ref": "#/definitions/CharacteristicStatus"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/definitions/CharacteristicValue"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "label",
        "spec",
        "access",
        "value",
        "status",
        "error"
      ],
      "type": "object"
    },
    "CharacteristicAccess": {
      "properties": {
        "notify": {
          "type": "boolean"
        },
        "read": {
          "type": "boolean"
        },
        "write": {
          "type": "boolean"
        }
      },
      "required": [
        "read",
        "write",
        "notify"
      ],
      "type": "object"
    },
    "CharacteristicSpec": {
      "oneOf": [
        {
          "properties": {
            "integer": {
              "type": "boolean"
            },
            "kind": {
              "const": "number",
              "type": "string"
            },
            "maximum": {
              "type": [
                "number",
                "null"
              ]
            },
            "minimum": {
              "type": [
                "number",
                "null"
              ]
            },
            "step": {
              "type": [
                "number",
                "null"
              ]
            },
            "unit": {
              "maxLength": 32,
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "minimum",
            "maximum",
            "step",
            "integer",
            "unit"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "boolean",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "enum",
              "type": "string"
            },
            "options": {
              "items": {
                "$ref": "#/definitions/EnumOption"
              },
              "maxItems": 32,
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "kind",
            "options"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "string",
              "type": "string"
            },
            "maxLength": {
              "maximum": 1024,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "maxLength"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "action",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "CharacteristicStatus": {
      "enum": [
        "ok",
        "unavailable",
        "error"
      ],
      "type": "string"
    },
    "CharacteristicValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "maxLength": 1024,
          "type": "string"
        }
      ]
    },
    "Device": {
      "properties": {
        "characteristics": {
          "items": {
            "$ref": "#/definitions/Characteristic"
          },
          "maxItems": 64,
          "type": "array"
        },
        "driver": {
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/definitions/ApiError"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
          "type": "string"
        },
        "label": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/DeviceStatus"
        }
      },
      "required": [
        "id",
        "driver",
        "kind",
        "label",
        "status",
        "error",
        "characteristics"
      ],
      "type": "object"
    },
    "DeviceStatus": {
      "enum": [
        "online",
        "unavailable"
      ],
      "type": "string"
    },
    "DriverState": {
      "enum": [
        "disabled",
        "online",
        "disconnected",
        "ambiguous",
        "permission_denied",
        "error"
      ],
      "type": "string"
    },
    "DriverStatus": {
      "properties": {
        "error": {
          "anyOf": [
            {
              "$ref": "#/definitions/ApiError"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "state": {
          "$ref": "#/definitions/DriverState"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "state",
        "error"
      ],
      "type": "object"
    },
    "EnumOption": {
      "properties": {
        "label": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "value": {
          "maxLength": 1024,
          "type": "string"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "invalid_request",
        "forbidden_origin",
        "forbidden_host",
        "unknown_device",
        "unknown_characteristic",
        "ambiguous_device",
        "driver_conflict",
        "unsupported_operation",
        "invalid_value",
        "permission_denied",
        "device_unavailable",
        "ddc_error",
        "plugin_error",
        "unsupported_capability",
        "busy",
        "timeout"
      ],
      "type": "string"
    },
    "LogEntry": {
      "properties": {
        "id": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "level": {
          "$ref": "#/definitions/LogLevel"
        },
        "message": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "timestamp": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|\\+00:00)$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "timestamp",
        "level",
        "target",
        "message"
      ],
      "type": "object"
    },
    "LogLevel": {
      "enum": [
        "debug",
        "info",
        "warn",
        "error"
      ],
      "type": "string"
    },
    "NodeInfo": {
      "properties": {
        "instanceId": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "nodeId": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        }
      },
      "required": [
        "nodeId",
        "instanceId",
        "name"
      ],
      "type": "object"
    },
    "Snapshot": {
      "properties": {
        "apiVersion": {
          "maximum": 1,
          "minimum": 1,
          "type": "integer"
        },
        "devices": {
          "items": {
            "$ref": "#/definitions/Device"
          },
          "maxItems": 64,
          "type": "array"
        },
        "drivers": {
          "items": {
            "$ref": "#/definitions/DriverStatus"
          },
          "maxItems": 16,
          "type": "array"
        },
        "node": {
          "$ref": "#/definitions/NodeInfo"
        },
        "revision": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "type": "string"
        }
      },
      "required": [
        "apiVersion",
        "node",
        "revision",
        "drivers",
        "devices"
      ],
      "type": "object"
    }
  },
  "oneOf": [
    {
      "properties": {
        "snapshot": {
          "$ref": "#/definitions/Snapshot"
        },
        "type": {
          "const": "snapshot",
          "type": "string"
        }
      },
      "required": [
        "type",
        "snapshot"
      ],
      "type": "object"
    },
    {
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/definitions/LogEntry"
          },
          "maxItems": 200,
          "type": "array"
        },
        "type": {
          "const": "logs",
          "type": "string"
        }
      },
      "required": [
        "type",
        "entries"
      ],
      "type": "object"
    },
    {
      "properties": {
        "entry": {
          "$ref": "#/definitions/LogEntry"
        },
        "type": {
          "const": "log",
          "type": "string"
        }
      },
      "required": [
        "type",
        "entry"
      ],
      "type": "object"
    }
  ],
  "title": "ServerEvent"
}
