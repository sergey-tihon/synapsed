{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "LogEntry": {
      "properties": {
        "id": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "level": {
          "$ref": "#/definitions/LogLevel"
        },
        "message": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "timestamp": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|\\+00:00)$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "timestamp",
        "level",
        "target",
        "message"
      ],
      "type": "object"
    },
    "LogLevel": {
      "enum": [
        "debug",
        "info",
        "warn",
        "error"
      ],
      "type": "string"
    },
    "NodeInfo": {
      "properties": {
        "instanceId": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "nodeId": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        }
      },
      "required": [
        "nodeId",
        "instanceId",
        "name"
      ],
      "type": "object"
    }
  },
  "properties": {
    "entries": {
      "items": {
        "$ref": "#/definitions/LogEntry"
      },
      "maxItems": 200,
      "type": "array"
    },
    "node": {
      "$ref": "#/definitions/NodeInfo"
    }
  },
  "required": [
    "node",
    "entries"
  ],
  "title": "LogsResponse",
  "type": "object"
}
