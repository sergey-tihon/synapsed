{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ApiError": {
      "description": "An API error with a bounded, user-safe message.",
      "properties": {
        "code": {
          "allOf": [
            {
              "$ref": "#/definitions/ErrorCode"
            }
          ],
          "description": "Category identifying the kind of failure."
        },
        "message": {
          "description": "Bounded human-readable description of the failure.",
          "maxLength": 256,
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "CharacteristicAccess": {
      "description": "Read, write, and notification permissions for a characteristic.",
      "properties": {
        "notify": {
          "description": "Updates may be pushed without polling.",
          "type": "boolean"
        },
        "read": {
          "description": "The current value may be observed.",
          "type": "boolean"
        },
        "write": {
          "description": "A command may change the characteristic.",
          "type": "boolean"
        }
      },
      "required": [
        "read",
        "write",
        "notify"
      ],
      "type": "object"
    },
    "CharacteristicSpec": {
      "description": "Metadata describing the shape and constraints of a characteristic value.",
      "oneOf": [
        {
          "description": "Numeric value with optional bounds, step, integer restriction, and unit.",
          "properties": {
            "integer": {
              "description": "Whether values must be integral.",
              "type": "boolean"
            },
            "kind": {
              "const": "number",
              "type": "string"
            },
            "maximum": {
              "description": "Inclusive maximum value, when specified.",
              "type": [
                "number",
                "null"
              ]
            },
            "minimum": {
              "description": "Inclusive minimum value, when specified.",
              "type": [
                "number",
                "null"
              ]
            },
            "step": {
              "description": "Positive increment supported by step commands, when specified.",
              "type": [
                "number",
                "null"
              ]
            },
            "unit": {
              "description": "Optional unit label.",
              "maxLength": 32,
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "minimum",
            "maximum",
            "step",
            "integer",
            "unit"
          ],
          "type": "object"
        },
        {
          "description": "Boolean value.",
          "properties": {
            "kind": {
              "const": "boolean",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "One value selected from a bounded set of options.",
          "properties": {
            "kind": {
              "const": "enum",
              "type": "string"
            },
            "options": {
              "description": "Available enum values and their labels.",
              "items": {
                "$ref": "#/definitions/EnumOption"
              },
              "maxItems": 32,
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "kind",
            "options"
          ],
          "type": "object"
        },
        {
          "description": "Text value with a maximum character count.",
          "properties": {
            "kind": {
              "const": "string",
              "type": "string"
            },
            "maxLength": {
              "description": "Maximum number of Unicode scalar values accepted.",
              "maximum": 1024,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "maxLength"
          ],
          "type": "object"
        },
        {
          "description": "Write-only action without a stored value.",
          "properties": {
            "kind": {
              "const": "action",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "CharacteristicStatus": {
      "description": "Availability state of a characteristic observation.",
      "oneOf": [
        {
          "const": "ok",
          "description": "The characteristic has a valid current observation.",
          "type": "string"
        },
        {
          "const": "unavailable",
          "description": "The characteristic is temporarily unavailable.",
          "type": "string"
        },
        {
          "const": "error",
          "description": "The characteristic operation or observation failed.",
          "type": "string"
        }
      ]
    },
    "CharacteristicValue": {
      "anyOf": [
        {
          "description": "Boolean characteristic value.",
          "type": "boolean"
        },
        {
          "description": "Finite numeric characteristic value.",
          "type": "number"
        },
        {
          "description": "Bounded text characteristic value.",
          "maxLength": 1024,
          "type": "string"
        }
      ],
      "description": "JSON-compatible value of a characteristic observation or command."
    },
    "EnumOption": {
      "description": "A permitted value and its user-facing label for an enum characteristic.",
      "properties": {
        "label": {
          "description": "User-facing label for the value.",
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "value": {
          "description": "Serialized enum value.",
          "maxLength": 1024,
          "type": "string"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "type": "object"
    },
    "ErrorCode": {
      "description": "Machine-readable category describing an API error.",
      "oneOf": [
        {
          "const": "invalid_request",
          "description": "The request could not be parsed or otherwise violates the API contract.",
          "type": "string"
        },
        {
          "const": "forbidden_origin",
          "description": "The request origin is not allowed.",
          "type": "string"
        },
        {
          "const": "forbidden_host",
          "description": "The request host is not allowed.",
          "type": "string"
        },
        {
          "const": "unknown_device",
          "description": "The requested device does not exist.",
          "type": "string"
        },
        {
          "const": "unknown_characteristic",
          "description": "The requested characteristic does not exist.",
          "type": "string"
        },
        {
          "const": "ambiguous_device",
          "description": "The request identifies more than one device.",
          "type": "string"
        },
        {
          "const": "driver_conflict",
          "description": "The requested driver operation conflicts with current ownership.",
          "type": "string"
        },
        {
          "const": "unsupported_operation",
          "description": "The requested operation is not supported.",
          "type": "string"
        },
        {
          "const": "invalid_value",
          "description": "A supplied value is invalid.",
          "type": "string"
        },
        {
          "const": "permission_denied",
          "description": "The operation is not permitted.",
          "type": "string"
        },
        {
          "const": "device_unavailable",
          "description": "The requested device is unavailable.",
          "type": "string"
        },
        {
          "const": "ddc_error",
          "description": "A DDC transport operation failed.",
          "type": "string"
        },
        {
          "const": "plugin_error",
          "description": "A driver plugin operation failed.",
          "type": "string"
        },
        {
          "const": "unsupported_capability",
          "description": "The requested capability is not supported.",
          "type": "string"
        },
        {
          "const": "busy",
          "description": "The operation could not proceed because the service is busy.",
          "type": "string"
        },
        {
          "const": "timeout",
          "description": "The operation exceeded its deadline.",
          "type": "string"
        }
      ]
    }
  },
  "description": "A characteristic declaration, access policy, and optional current observation.",
  "properties": {
    "access": {
      "allOf": [
        {
          "$ref": "#/definitions/CharacteristicAccess"
        }
      ],
      "description": "Permissions granted for this characteristic."
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/definitions/ApiError"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional safe description of an error."
    },
    "group": {
      "description": "Identifier of the device group this characteristic belongs to, if the device declares groups.",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "description": "Stable identifier within the device.",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
      "type": "string"
    },
    "label": {
      "description": "User-facing characteristic label.",
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "spec": {
      "allOf": [
        {
          "$ref": "#/definitions/CharacteristicSpec"
        }
      ],
      "description": "Value type and metadata constraints."
    },
    "status": {
      "allOf": [
        {
          "$ref": "#/definitions/CharacteristicStatus"
        }
      ],
      "description": "Current availability of the characteristic."
    },
    "value": {
      "anyOf": [
        {
          "$ref": "#/definitions/CharacteristicValue"
        },
        {
          "type": "null"
        }
      ],
      "description": "Most recently observed value, when one is available."
    }
  },
  "required": [
    "id",
    "label",
    "group",
    "spec",
    "access",
    "value",
    "status",
    "error"
  ],
  "title": "Characteristic",
  "type": "object"
}
