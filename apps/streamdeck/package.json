{
  "name": "@synapsed/streamdeck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rollup -c && vite build -c inspector/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p inspector/tsconfig.json",
    "test": "vitest run",
    "link": "streamdeck link ./com.sergey-tihon.synapsed.sdPlugin",
    "restart": "streamdeck restart com.sergey-tihon.synapsed",
    "validate": "streamdeck validate ./com.sergey-tihon.synapsed.sdPlugin",
    "pack": "node ../../scripts/workspace.mjs pack-plugin",
    "watch:plugin": "rollup -c -w --watch.onEnd=\"streamdeck restart com.sergey-tihon.synapsed\"",
    "watch:inspector": "vite build --watch -c inspector/vite.config.ts",
    "watch": "npm run watch:plugin & npm run watch:inspector"
  },
  "dependencies": {
    "@elgato/streamdeck": "3.0.4",
    "@synapsed/client": "0.1.0",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@elgato/cli": "1.10.4",
    "@elgato/utils": "0.6.2",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.2",
    "@rollup/plugin-typescript": "12.3.1",
    "@solidjs/vite-plugin": "3.0.0-next.52",
    "@solidjs/web": "2.0.0-rc.19",
    "@tsconfig/node24": "24.0.5",
    "@types/node": "26.6.6",
    "jsdom": "30.1.3",
    "rollup": "^4.67.4",
    "solid-js": "2.0.0-rc.19",
    "tslib": "^2.9.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
