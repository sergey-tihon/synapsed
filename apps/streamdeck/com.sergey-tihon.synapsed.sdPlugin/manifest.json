{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "Synapsed",
  "Version": "0.1.0.0",
  "Author": "Sergey Tihon",
  "Description": "Inspect and control local device characteristics through Synapsed.",
  "UUID": "com.sergey-tihon.synapsed",
  "Icon": "imgs/plugin/marketplace",
  "Category": "Synapsed",
  "CategoryIcon": "imgs/plugin/category-icon",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "Nodejs": {
    "Version": "24"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    }
  ],
  "Actions": [
    {
      "Name": "Key",
      "UUID": "com.sergey-tihon.synapsed.key",
      "Icon": "imgs/actions/characteristic/icon",
      "Tooltip": "Run a command on a device characteristic.",
      "PropertyInspectorPath": "bin/inspector/index.html",
      "Controllers": ["Keypad"],
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/actions/characteristic/key",
          "Title": "Configure",
          "TitleAlignment": "middle"
        }
      ]
    },
    {
      "Name": "Dial",
      "UUID": "com.sergey-tihon.synapsed.dial",
      "Icon": "imgs/actions/characteristic/icon",
      "Tooltip": "Rotate to step a characteristic; press to toggle or run an action on the same device.",
      "PropertyInspectorPath": "bin/inspector/index.html",
      "Controllers": ["Encoder"],
      "UserTitleEnabled": false,
      "Encoder": {
        "Icon": "imgs/actions/characteristic/key",
        "layout": "layouts/metric.json",
        "TriggerDescription": {
          "Rotate": "Step the selected characteristic",
          "Push": "Run the configured press action"
        }
      },
      "States": [{ "Image": "imgs/actions/characteristic/key" }]
    }
  ]
}
