{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "synapsed-raycast",
  "version": "0.1.0",
  "title": "Synapsed",
  "description": "Inspect and control local Synapsed devices",
  "author": "sergey_tihon",
  "icon": "icon.png",
  "categories": [
    "System"
  ],
  "license": "MIT",
  "platforms": [
    "macOS"
  ],
  "commands": [
    {
      "name": "devices",
      "title": "Devices",
      "description": "Inspect and control local device characteristics",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "endpoint",
      "title": "Endpoint",
      "description": "HTTP loopback origin of the local Synapsed daemon",
      "type": "textfield",
      "required": true,
      "default": "http://127.0.0.1:24816"
    }
  ],
  "scripts": {
    "build": "node scripts/run-ray.mjs build",
    "lint": "node scripts/run-ray.mjs lint",
    "dev": "node scripts/run-ray.mjs develop",
    "pack": "node scripts/run-ray.mjs bundle"
  },
  "dependencies": {
    "@raycast/api": "2.10.1",
    "@synapsed/client": "0.1.0",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/node": "26.6.5",
    "typescript": "5.9.3",
    "@raycast/eslint-config": "2.2.0",
    "eslint": "10.14.0",
    "prettier": "3.8.3"
  }
}
